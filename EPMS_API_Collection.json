{
  "info": {
    "name": "EPMS - Education Progress Monitoring System API",
    "description": "Comprehensive Postman Collection covering Authentication, Administrative endpoints, Attendance, Exams, Assignments, Reports, and Notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Admin Operations",
      "item": [
        {
          "name": "Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "dashboard"] }
          }
        },
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/departments", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "departments"] }
          }
        },
        {
          "name": "List Classes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/classes", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "classes"] }
          }
        },
        {
          "name": "List Subjects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/subjects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "subjects"] }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List All Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/students", "host": ["{{baseUrl}}"], "path": ["api", "v1", "students"] }
          }
        },
        {
          "name": "Get Student Progress Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/students/1/progress", "host": ["{{baseUrl}}"], "path": ["api", "v1", "students", "1", "progress"] }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Bulk Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classId\": 1,\n  \"subjectId\": 1,\n  \"date\": \"2024-11-06\",\n  \"attendanceRecords\": [\n    { \"studentId\": 1, \"status\": \"PRESENT\", \"remarks\": \"On time\" },\n    { \"studentId\": 2, \"status\": \"LATE\", \"remarks\": \"Bus delay\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/attendance/bulk", "host": ["{{baseUrl}}"], "path": ["api", "v1", "attendance", "bulk"] }
          }
        },
        {
          "name": "Student Attendance Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/attendance/student/1/summary", "host": ["{{baseUrl}}"], "path": ["api", "v1", "attendance", "student", "1", "summary"] }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Download Student Report Card (PDF)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/reports/student/1/pdf", "host": ["{{baseUrl}}"], "path": ["api", "v1", "reports", "student", "1", "pdf"] }
          }
        },
        {
          "name": "Download Class Attendance (Excel)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/reports/class/1/attendance/excel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "reports", "class", "1", "attendance", "excel"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwtToken", "value": "" }
  ]
}
